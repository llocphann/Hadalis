pkgname=inir-niri-preview
pkgver=0.2.0
pkgrel=1
pkgdesc='Hadalis adaptive Niri window preview QML plugin'
arch=(x86_64 aarch64)
url='https://github.com/llocphann/Hadalis'
license=('GPL-3.0-only')
depends=(
  glibc
  pipewire
  qt6-base
  qt6-declarative
)
makedepends=(
  cmake
  ninja
  pkgconf
)
source=()
sha256sums=()

build() {
  cmake -GNinja -B "$srcdir/build" -S "$startdir/plugin" \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"

  install -d "$pkgdir/usr/share/inir"
  cat > "$pkgdir/usr/share/inir/niri-preview-plugin" <<EOF
version=$pkgver-$pkgrel
backend=mutter-screencast
transport=pipewire-shm
EOF
}
