post_install() {
  cat <<'EOF'
Hadalis has been installed.

Recommended next steps:
  - Start the shell manually with: inir run
  - Or wire the user service to the detected compositor and start it with:
      inir service enable
      inir service start

The running QML shell currently stores user config in:
  ~/.config/illogical-impulse/config.json

Hadalis maintenance tooling also recognizes ~/.config/inir for migrated installs.

The packaged runtime lives in:
  /usr/share/quickshell/inir
EOF
}

post_upgrade() {
  cat <<'EOF'
Hadalis has been upgraded.

Recommended next steps:
  - Restart the shell with: inir restart
  - Package-managed installs use pacman for updates.
  - Runtime migrations, when needed, are applied by Hadalis's packaged lifecycle.
EOF
}

pre_remove() {
  if [[ -x /usr/libexec/inir-battery-charge-limit ]]; then
    /usr/libexec/inir-battery-charge-limit --config-reset >/dev/null 2>&1 || true
    /usr/libexec/inir-battery-charge-limit --disable >/dev/null 2>&1 || true
  fi

  rm -f \
    /etc/tlp.d/99-inir-battery-charge-limit.conf \
    /etc/tlp.d/99-inir-tlp-settings.conf
}

post_remove() {
  cat <<'EOF'
Hadalis has been removed.

Pacman does not modify per-user systemd state. If an account previously ran
'inir service enable' without first running 'inir service disable', remove any
dangling compositor wants link in that account and reload its user manager:

  find "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user" -path '*.wants/inir.service' -type l -delete
  systemctl --user daemon-reload

For future removals, run 'inir service disable' as each affected user before
removing the package.
EOF
}
