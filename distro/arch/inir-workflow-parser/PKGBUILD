pkgname=inir-workflow-parser
pkgver=0.3.1
pkgrel=1
pkgdesc='Native tree-sitter QML grammar for Hadalis Code Workflow'
arch=(x86_64)
url='https://github.com/yuja/tree-sitter-qmljs'
license=('MIT')
depends=(glibc tree-sitter)
source=(
  "tree-sitter-qmljs-${pkgver}.tar.gz::https://static.crates.io/crates/tree-sitter-qmljs/tree-sitter-qmljs-${pkgver}.crate"
)
sha256sums=('e6ed3a7040df54fed1183801ad482139622bf9b9ec1c5f7ee36c5ece25806c58')

build() {
  cd "${srcdir}/tree-sitter-qmljs-${pkgver}"
  "${CC:-cc}" ${CFLAGS} ${CPPFLAGS} -std=c11 -fPIC -shared -I src \
    src/parser.c src/scanner.c ${LDFLAGS} -o "${srcdir}/qmljs.so"
}

package() {
  install -Dm755 "${srcdir}/qmljs.so" \
    "${pkgdir}/usr/lib/inir/code-workflow/qmljs.so"
  install -Dm644 "${srcdir}/tree-sitter-qmljs-${pkgver}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
