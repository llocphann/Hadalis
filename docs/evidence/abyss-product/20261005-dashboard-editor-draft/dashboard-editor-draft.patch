+++ b/modules/abyss/AbyssDashboardEditor.qml
@@ -0,0 +1,48 @@
+import QtQuick
+import "looks/DashboardEditorPlacement.js" as Placement
+
+// The ordinary Abyss body paints this popup in the output's existing field.
+// Its owner remains the only authority for Dashboard/workspace dimensions.
+AbyssBodyHost {
+    id: root
+    required property AbyssBodyHost ownerBody
+    readonly property var canvasController:
+        root.ownerBody?.contentItem.item?.canvasController ?? null
+    readonly property real availableHeightAbove: Math.max(0,
+        (root.ownerBody?.record.content.y ?? 0)
+        - (root.ownerBody?.padding ?? 0) - root.edgeInsets.top)
+    readonly property real availableHeightBelow: Math.max(0,
+        root.height - root.edgeInsets.bottom
+        - (root.ownerBody?.record.content.y ?? 0)
+        - (root.ownerBody?.record.content.height ?? 0)
+        - (root.ownerBody?.padding ?? 0))
+    readonly property real maximumFreeHeight:
+        Math.max(root.availableHeightAbove,root.availableHeightBelow)
+    readonly property bool compactToolbar: root.maximumFreeHeight < 80
+    readonly property real toolSize: root.compactToolbar
+        ? Math.max(1,Math.min(34,root.maximumFreeHeight)) : 34
+    anchors.fill: parent
+    outputName: root.ownerBody?.outputName ?? ""
+    controller: root.ownerBody?.controller ?? null
+    edge: root.ownerBody?.edge ?? "bottom"
+    edgeInsets: root.controller?.edgeInsets
+        ?? root.ownerBody?.edgeInsets ?? {left:8,top:8,right:8,bottom:8}
+    open: (root.ownerBody?.acceptsInput ?? false)
+        && (root.ownerBody?.contentItem.item?.layoutEditingAvailable ?? true)
+        && (root.canvasController?.editMode ?? false)
+    participatesInPlacement: false
+    stableContentSize: true
+    animatePlacementChanges: false
+    padding: root.compactToolbar
+        ? Math.max(0,Math.min(4,(root.maximumFreeHeight-root.toolSize)/2)) : 8
+    attachedGeometry: Placement.geometry(root.ownerBody?.record.content,
+        root.ownerBody?.padding ?? 0,root.width,root.height,root.edgeInsets,
+        root.contentItem.item?.implicitWidth ?? 600,
+        root.contentItem.item?.implicitHeight
+            ?? (root.compactToolbar ? root.toolSize : 55),root.padding,root.edge)
+    span: root.attachedGeometry.span
+    depth: root.attachedGeometry.depth
+    along: root.attachedGeometry.along
+    source: "content/AbyssDashboardEditorContent.qml"
+    onCloseRequested: root.canvasController?.cancelEditMode()
+}
