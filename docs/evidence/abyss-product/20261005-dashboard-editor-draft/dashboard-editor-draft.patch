+++ b/modules/abyss/looks/AbyssGeometry.js
@@ -133,6 +133,28 @@ function placedPanel(width,height,insets,edge,along,span,depth,progress,padding,
         along:placedAlong
     };
 }
+// Owner-attached controls reveal through the same body content/input clip.
+// The full target stays fixed so neither the controls nor the owner's widgets
+// are rescaled or repacked while the visible field surface opens.
+function revealAttached(record, progress) {
+    var reveal = clamp(progress, 0, 1);
+    if (reveal === 1) return record;
+    var surface = record.surface;
+    var height = surface.height * reveal;
+    var y = record.attachedSide === "below"
+        ? surface.y : surface.y + surface.height - height;
+    var content = record.content;
+    var contentY = Math.max(content.y, y);
+    var contentEnd = Math.min(content.y + content.height, y + height);
+    return Object.assign({}, record, {
+        progress: reveal,
+        surface: reveal > 0
+            ? {x:surface.x, y:y, width:surface.width, height:height}
+            : {x:0, y:0, width:0, height:0},
+        content: {x:content.x, y:contentY, width:content.width,
+            height:Math.max(0, contentEnd-contentY)}
+    });
+}
 function roundedDistance(x, y, rect, radius) {
     var r = Math.min(radius, rect.width/2, rect.height/2);
     var qx = Math.abs(x-rect.x-rect.width/2)-rect.width/2+r;
