diff --git a/modules/abyss/looks/DashboardEditorPlacement.js b/modules/abyss/looks/DashboardEditorPlacement.js
new file mode 100644
index 0000000000000000000000000000000000000000..f2c9c02727dcb0ee83eea45b164ab01ab05905a1
--- /dev/null
+++ b/modules/abyss/looks/DashboardEditorPlacement.js
@@ -0,0 +1,52 @@
+// Popup geometry follows the rendered Dashboard. It does not enter the
+// owner's allocator or subtract any space from the editable workspace.
+function _finite(value, fallback) {
+    var number = Number(value);
+    return Number.isFinite(number) ? number : fallback;
+}
+function geometry(anchor, ownerPadding, width, height, insets,
+                  naturalWidth, naturalHeight, padding, edge) {
+    anchor = anchor || {x:0,y:0,width:0,height:0};
+    var left = _finite(insets?.left, 8);
+    var top = _finite(insets?.top, 8);
+    var right = Math.max(left, width-_finite(insets?.right, 8));
+    var bottom = Math.max(top, height-_finite(insets?.bottom, 8));
+    var p = Math.max(0, _finite(padding, 8));
+    var fullWidth = Math.min(Math.max(0,right-left),
+        Math.max(1, Math.min(_finite(naturalWidth,600)+p*2,
+            _finite(anchor.width,600)+ownerPadding*2)));
+    var fullHeight = Math.min(Math.max(0,bottom-top),
+        Math.max(1,_finite(naturalHeight,55)+p*2));
+    p = Math.min(p,fullWidth/2,fullHeight/2);
+    var x = Math.max(left,Math.min(right-fullWidth,
+        anchor.x+(anchor.width-fullWidth)/2));
+    var ownerTop = anchor.y-ownerPadding;
+    var ownerBottom = anchor.y+anchor.height+ownerPadding;
+    var aboveSpace = Math.max(0,ownerTop-top);
+    var belowSpace = Math.max(0,bottom-ownerBottom);
+    var side = aboveSpace >= fullHeight ? "above"
+        : belowSpace >= fullHeight ? "below"
+        : aboveSpace >= belowSpace ? "above" : "below";
+    var gap = Math.min(8,Math.max(0,
+        (side === "above" ? aboveSpace : belowSpace)-fullHeight));
+    var y = side === "above"
+        ? ownerTop-gap-fullHeight : ownerBottom+gap;
+    // Extremely full outputs use the nearest bounded popup rectangle. The
+    // Dashboard's actual widget sizes still remain untouched.
+    y = Math.max(top,Math.min(bottom-fullHeight,y));
+    var reach = side === "below"
+        ? Math.max(0,y-ownerBottom) : Math.max(0,ownerTop-y-fullHeight);
+    var surfaceY = side === "below" ? y-reach-2 : y;
+    var surfaceHeight = fullHeight+reach+2;
+    var horizontal = edge === "top" || edge === "bottom";
+    return {
+        edge:edge, attachedSide:side, progress:1,
+        along:horizontal ? x : surfaceY,
+        span:horizontal ? fullWidth : surfaceHeight,
+        depth:horizontal ? surfaceHeight : fullWidth,
+        targetDepth:horizontal ? surfaceHeight : fullWidth,
+        surface:{x:x,y:surfaceY,width:fullWidth,height:surfaceHeight},
+        content:{x:x+p,y:y+p,width:Math.max(0,fullWidth-p*2),
+            height:Math.max(0,fullHeight-p*2)}
+    };
+}
diff --git a/scripts/test-abyss-dashboard-editor-placement.py b/scripts/test-abyss-dashboard-editor-placement.py
new file mode 100644
index 0000000000000000000000000000000000000000..43e837a223db8010136e05cf7d4d6ea6ccb014ed
--- /dev/null
+++ b/scripts/test-abyss-dashboard-editor-placement.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Exercise owner-attached Dashboard geometry and fixed-size reveal."""
+from pathlib import Path
+import subprocess
+
+root = Path(__file__).resolve().parents[1]
+program = (root / "modules/abyss/looks/AbyssGeometry.js").read_text()
+program += "\n" + (root / "modules/abyss/looks/DashboardEditorPlacement.js").read_text()
+program += r"""
+const assert=require('node:assert/strict');
+const workInsets={left:8,top:48,right:8,bottom:8};
+let cases=0;
+for(const width of [384,800,1100,1920]) {
+ for(const height of [600,800,1080]) {
+  for(const edge of ['top','bottom','left','right']) {
+   for(const ownerY of [70,height*.35,height*.6]) {
+    const owner={x:24,y:ownerY,width:width-48,height:height*.3};
+    const snapshot=JSON.stringify(owner);
+    const padding=8;
+    const full=geometry(owner,padding,width,height,workInsets,1100,55,8,edge);
+    const c=full.content,s=full.surface;
+    assert(c.x>=workInsets.left && c.y>=workInsets.top);
+    assert(c.x+c.width<=width-workInsets.right+1e-6);
+    assert(c.y+c.height<=height-workInsets.bottom+1e-6);
+    const above=owner.y-padding-workInsets.top;
+    const below=height-workInsets.bottom-owner.y-owner.height-padding;
+    if(above>=71) {
+     assert.equal(full.attachedSide,'above','room above is preferred');
+     assert(c.y+c.height<=owner.y-padding);
+    } else if(below>=71) {
+     assert.equal(full.attachedSide,'below','insufficient room above flips below');
+     assert(c.y>=owner.y+owner.height+padding);
+    }
+    assert.equal(JSON.stringify(owner),snapshot,'placement never changes owner size');
+    assert.strictEqual(revealAttached(full,1),full);
+    for(const progress of [0,.05,.25,.75]) {
+     const r=revealAttached(full,progress);
+     assert.equal(r.progress,progress);
+     assert.equal(r.content.width,c.width,'reveal clips full-size controls');
+     assert(r.content.height<=c.height && r.content.height>=0);
+     assert(r.surface.height<=s.height);
+     if(progress>0) {
+      assert.equal(r.surface.x,s.x);
+      assert.equal(r.surface.width,s.width);
+      assert(r.content.y>=r.surface.y);
+      assert(r.content.y+r.content.height<=r.surface.y+r.surface.height+1e-6
+          || r.content.height===0);
+      assert.equal(full.attachedSide==='above'
+          ? r.surface.y+r.surface.height : r.surface.y,
+          full.attachedSide==='above' ? s.y+s.height : s.y,
+          'reveal stays attached to its owner');
+     } else assert.equal(r.surface.width,0);
+    }
+    cases++;
+   }
+  }
+ }
+}
