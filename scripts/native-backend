#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/inir"; BACKEND_STATE_FILE="$STATE_DIR/native-backend"; BIN_STATE_FILE="$STATE_DIR/native-bin-dir"
usage() { echo "Usage: scripts/native-backend {status|rust|python}"; }
restart_shell() { if [[ -x "$ROOT_DIR/scripts/inir" ]]; then "$ROOT_DIR/scripts/inir" restart >/dev/null 2>&1 && return 0; fi; systemctl --user restart inir.service; }
case "${1:-status}" in status) exec "$ROOT_DIR/scripts/native-dispatch" backend-info;; rust|python) mode="$1"; mkdir -p "$STATE_DIR"; printf '%s\n' "$mode" > "$BACKEND_STATE_FILE"; rm -f "$BIN_STATE_FILE"; if command -v systemctl >/dev/null 2>&1; then systemctl --user unset-environment INIR_NATIVE_BACKEND INIR_NATIVE_BIN_DIR INIR_NATIVE_STRICT >/dev/null 2>&1 || true; systemctl --user is-active --quiet inir.service 2>/dev/null && restart_shell || true; fi; "$ROOT_DIR/scripts/native-dispatch" backend-info;; *) usage >&2; exit 64;; esac
