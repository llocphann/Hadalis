#!/usr/bin/env bash
set -uo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/inir"
MODE_FILE="$STATE_DIR/native-backend"
MODE="${INIR_NATIVE_BACKEND:-}"
if [[ -z "$MODE" && -r "$MODE_FILE" ]]; then
    IFS= read -r MODE < "$MODE_FILE" || true
fi
# Rust is the production default; persisted state or an explicit environment override can force Python.
MODE="${MODE:-rust}"
case "$MODE" in
    python|rust|auto) ;;
    *) echo "[native-dispatch] invalid INIR_NATIVE_BACKEND=$MODE" >&2; exit 64 ;;
esac
BIN_DIR_FILE="$STATE_DIR/native-bin-dir"
BIN_DIR="${INIR_NATIVE_BIN_DIR:-}"
if [[ -z "$BIN_DIR" && -r "$BIN_DIR_FILE" ]]; then
    IFS= read -r BIN_DIR < "$BIN_DIR_FILE" || true
fi
DEFAULT_BIN_DIR="$ROOT_DIR/native/bin"
if [[ ! -x "$DEFAULT_BIN_DIR/inir-native" && -x "$ROOT_DIR/native/target/release/inir-native" ]]; then
    DEFAULT_BIN_DIR="$ROOT_DIR/native/target/release"
fi
BIN_DIR="${BIN_DIR:-$DEFAULT_BIN_DIR}"
STRICT="${INIR_NATIVE_STRICT:-0}"
MPD_SOCKET="${INIR_MPD_SOCKET:-${XDG_RUNTIME_DIR:-/tmp}/inir/mpd.sock}"

python_bin() {
    local candidate=""
    if [[ -n "${INIR_VENV:-}" ]]; then
        candidate="${INIR_VENV/#\~/$HOME}/bin/python3"
    elif [[ -n "${ILLOGICAL_IMPULSE_VIRTUAL_ENV:-}" ]]; then
        candidate="${ILLOGICAL_IMPULSE_VIRTUAL_ENV/#\~/$HOME}/bin/python3"
    else
        candidate="$HOME/.local/state/quickshell/.venv/bin/python3"
    fi
    if [[ -x "$candidate" ]]; then
        printf '%s\n' "$candidate"
    elif command -v python3 >/dev/null 2>&1; then
        # Nix wrappers provide the packaged Python environment through PATH.
        # Prefer it over a host /usr/bin/python3 so Python fallback keeps its
        # declared dependencies without switchwall activating a venv first.
        command -v python3
    elif [[ -x /usr/bin/python3 ]]; then
        printf '%s\n' /usr/bin/python3
    else
        return 127
    fi
}

python_exec() {
    local py
    if ! py="$(python_bin)"; then
        echo "[native-dispatch] Python fallback unavailable: python3 not found" >&2
        return 127
    fi
    exec "$py" "$@"
}

python_exec_with_module() {
    local module="$1"
    shift
    local candidate=""
    local preferred=""
    preferred="$(command -v python3 2>/dev/null || true)"
    for candidate in "$preferred" /usr/bin/python3 "$(python_bin 2>/dev/null || true)"; do
        [[ -n "$candidate" && -x "$candidate" ]] || continue
        if "$candidate" -c "import ${module}" >/dev/null 2>&1; then
            exec "$candidate" "$@"
        fi
    done
    echo "[native-dispatch] Python fallback unavailable: missing module ${module}" >&2
    return 127
}

want_rust() {
    case "$MODE" in
        rust|auto) return 0 ;;
        *) return 1 ;;
    esac
}

rust_ready() {
    local binary="$1"
    [[ -x "$BIN_DIR/$binary" ]]
}

cmd="${1:-}"
[[ -n "$cmd" ]] || {
    echo "usage: native-dispatch <input-lock|input-keys|super-tap|niri|diagnostics|qml-profile|clipboard-store|mpd|mpd-daemon|mpd-subscribe|lyrics|theme|desktop-icons|backend-info> [args...]" >&2
    exit 64
}
shift

if [[ "$MODE" == rust && "$STRICT" == 1 ]]; then
    required_binary=""
    case "$cmd" in
        input-lock|input-keys) required_binary=inir-inputd ;;
        super-tap) required_binary=inir-superd ;;
        niri|diagnostics|qml-profile|clipboard-store|desktop-icons) required_binary=inir-native ;;
        mpd|mpd-daemon|mpd-subscribe|lyrics) required_binary=inir-mpdd ;;
        theme) required_binary=inir-theme ;;
    esac
    if [[ -n "$required_binary" ]] && ! rust_ready "$required_binary"; then
        echo "[native-dispatch] missing Rust binary: $BIN_DIR/$required_binary" >&2
        exit 127
    fi
fi

case "$cmd" in
    backend-info)
        printf 'mode=%s\n' "$MODE"
        printf 'bin_dir=%s\n' "$BIN_DIR"
        printf 'strict=%s\n' "$STRICT"
        for binary in inir-inputd inir-superd inir-native inir-mpdd inir-theme; do
            if rust_ready "$binary"; then
                printf '%s=ready\n' "$binary"
            else
                printf '%s=missing\n' "$binary"
            fi
        done
        if python_bin >/dev/null 2>&1; then
            printf 'python=ready\n'
        else
            printf 'python=missing\n'
        fi
        ;;

    input-lock)
        if want_rust && rust_ready inir-inputd; then
            "$BIN_DIR/inir-inputd" --mode locks "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust input-lock failed ($rc), falling back to Python" >&2
        fi
        python_exec_with_module evdev -u "$ROOT_DIR/scripts/daemon/keyboard_lock_state_daemon.py" "$@"
        ;;

    input-keys)
        if want_rust && rust_ready inir-inputd; then
            "$BIN_DIR/inir-inputd" --mode keys "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust input-keys failed ($rc), falling back to Python" >&2
        fi
        python_exec_with_module evdev -u "$ROOT_DIR/scripts/daemon/osk_physical_key_daemon.py" "$@"
        ;;

    super-tap)
        if want_rust && rust_ready inir-superd; then
            "$BIN_DIR/inir-superd" "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust Super-tap daemon failed ($rc), falling back to Python" >&2
        fi
        python_exec_with_module evdev -u "$ROOT_DIR/scripts/daemon/inir_super_overview_daemon.py" "$@"
        ;;

    niri)
        if want_rust && rust_ready inir-native; then
            "$BIN_DIR/inir-native" niri "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust niri helper failed ($rc), falling back to Python" >&2
        fi
        python_exec "$ROOT_DIR/scripts/niri-config.py" "$@"
        ;;

    diagnostics)
        if want_rust && rust_ready inir-native; then
            "$BIN_DIR/inir-native" diagnostics "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust diagnostics failed ($rc), falling back to Python" >&2
        fi
        python_exec "$ROOT_DIR/scripts/runtime-diagnostics-sampler.py" "$@"
        ;;

    qml-profile)
        if rust_ready inir-native; then
            exec "$BIN_DIR/inir-native" qml-profile "$@"
        fi
        echo "[native-dispatch] QML profile attribution requires the Rust inir-native backend" >&2
        exit 69
        ;;

    clipboard-store)
        if want_rust && rust_ready inir-native; then
            "$BIN_DIR/inir-native" clipboard-filter "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust clipboard filter failed ($rc), falling back to Python" >&2
        fi
        python_exec "$ROOT_DIR/scripts/clipboard-store.py" "$@"
        ;;

    mpd)
        if want_rust && rust_ready inir-mpdd; then
            if [[ -S "$MPD_SOCKET" ]]; then
                "$BIN_DIR/inir-mpdd" --client-compat --socket "$MPD_SOCKET" "$@"
                rc=$?
                if (( rc != 75 || STRICT == 1 )); then
                    exit "$rc"
                fi
                echo "[native-dispatch] Rust MPD daemon transport unavailable, using direct compatibility mode" >&2
            fi

            "$BIN_DIR/inir-mpdd" --compat "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust MPD compatibility mode failed ($rc), falling back to Python" >&2
        fi
        python_exec "$ROOT_DIR/scripts/local_music_mpd.py" "$@"
        ;;

    mpd-daemon)
        if want_rust && rust_ready inir-mpdd; then
            exec "$BIN_DIR/inir-mpdd" --socket "$MPD_SOCKET" "$@"
        fi
        echo "[native-dispatch] persistent MPD daemon requires the Rust backend" >&2
        exit 69
        ;;

    mpd-subscribe)
        if want_rust && rust_ready inir-mpdd; then
            exec "$BIN_DIR/inir-mpdd" --subscribe --socket "$MPD_SOCKET"
        fi
        [[ $# -ge 2 ]] || {
            echo "[native-dispatch] Python MPD subscription requires HOST PORT [MUSIC_ROOT]" >&2
            exit 64
        }
        python_exec "$ROOT_DIR/scripts/local_music_mpd.py" subscribe "$@"
        ;;

    lyrics)
        track="${1:-}"
        [[ -n "$track" ]] || { echo "lyrics requires a track path" >&2; exit 64; }
        if want_rust && rust_ready inir-mpdd; then
            "$BIN_DIR/inir-mpdd" --lyrics "$track"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust lyrics parser failed ($rc), falling back to Python" >&2
        fi
        python_exec "$ROOT_DIR/scripts/local_music_lyrics.py" "$track"
        ;;

    theme)
        if want_rust && rust_ready inir-theme; then
            "$BIN_DIR/inir-theme" "$@"
            rc=$?
            if (( rc == 0 || STRICT == 1 )); then exit "$rc"; fi
            echo "[native-dispatch] Rust theme generator failed ($rc), falling back to Python" >&2
        fi
        python_exec "$ROOT_DIR/scripts/colors/generate_colors_material.py" "$@"
        ;;

    desktop-icons)
        theme="${1:-}"
        [[ -n "$theme" ]] || { echo "desktop-icons requires a theme" >&2; exit 64; }
        if want_rust && rust_ready inir-native; then
            exec "$BIN_DIR/inir-native" desktop sync-icon-theme "$theme"
        fi
        echo "[native-dispatch] desktop-icons native path requested while backend is not Rust" >&2
        exit 64
        ;;

    *)
        echo "[native-dispatch] unknown command: $cmd" >&2
        exit 64
        ;;
esac
