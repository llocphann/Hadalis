pkgname=inir-audio
pkgver=1.0
pkgrel=5
pkgdesc='iNiR - audio dependency bundle'
arch=(any)
license=('GPL-3.0-only')
depends=(
  # PipeWire audio stack
  pipewire
  pipewire-pulse
  pipewire-alsa
  wireplumber

  # Media control
  libdbusmenu-gtk3
  pavucontrol

  # Audio visualizer
  cava

  # Local Music backend
  mpd
  mpd-mpris
)

optdepends=(
  'easyeffects: optional audio effects and equalizer backend'
  'mpv: optional external media player'
  'mpv-mpris: optional MPRIS integration for mpv'
  'socat: optional EasyEffects control transport for equalizer'
)
